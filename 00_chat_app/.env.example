# Dimedove Cookbook - Chat App
# Copy this file to .env and fill in your values:

# Your Next.js app domain (used for CORS/redirects if needed)
NEXT_PUBLIC_FRONTEND_DOMAIN=http://localhost:3000

# The base URL for the Dimedove API
DIMEDOVE_API_BASE=https://api.dimedove.com/v1

# Your App ID (found in your dashboard app settings)
DIMEDOVE_APP_ID=your_app_id_here

# Your API secret key (found in your api key settings)
DIMEDOVE_API_KEY=your_api_key_here
